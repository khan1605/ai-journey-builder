{
  "name": "ai-journey-builder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Turn a plain-English prompt into a multi-step form journey. LLM generates step/field schemas; a safe whitelisted executor runs the configured actions.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "start": "npm --workspace server run start"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "mongoose": "^8.8.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
