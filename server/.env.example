# Copy to .env and fill in.
PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/ai_journey_builder

# LLM provider: "ollama" (local, free) or "anthropic" (hosted).
LLM_PROVIDER=ollama

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Anthropic (only if LLM_PROVIDER=anthropic). Key stays server-side, never in the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
