# Copy to .env and fill in.
PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/ai_journey_builder

# LLM provider: "ollama" (local), "openrouter" (free hosted), or "anthropic".
# If the provider fails or no key is set, a rule-based parser is used so the
# app never hard-fails.
LLM_PROVIDER=ollama

# Ollama (local dev)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# OpenRouter (free hosted models — recommended for cloud). Get a key at
# https://openrouter.ai (no card needed for free models). Server-side only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Anthropic (optional). Key stays server-side, never in the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
